<Project>
  <!-- Shared by every project. EnableWindowsTargeting lets the net7.0-windows projects build on the Linux CI runner. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- packages.lock.json files are committed: CI restores exactly them and keys its NuGet cache on them. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- A local build reads as 0.0.0; the release workflow sets the real version from the release tag. -->
    <VersionPrefix>0.0.0</VersionPrefix>
  </PropertyGroup>
</Project>
